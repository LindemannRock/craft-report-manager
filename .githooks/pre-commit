#!/usr/bin/env bash
# Read-only package checks; the workspace uses its supported DDEV PHP runtime.

set -u

PACKAGE_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$PACKAGE_ROOT/../.." 2>/dev/null && pwd -P)"

cd "$PACKAGE_ROOT" || {
    echo "Unable to enter the Report Manager package directory." >&2
    exit 1
}

if [ "$PACKAGE_ROOT" = "$WORKSPACE_ROOT/plugins/report-manager" ] && [ -f "$WORKSPACE_ROOT/.ddev/config.yaml" ]; then
    if ! command -v ddev >/dev/null 2>&1; then
        echo "Report Manager is inside the workspace DDEV project, but 'ddev' is unavailable." >&2
        echo "Install/start DDEV, then retry; host PHP is not a supported workspace fallback." >&2
        exit 127
    fi
    echo "Running Report Manager code quality checks through the workspace DDEV runtime..."
    (
        cd "$WORKSPACE_ROOT" || exit 1
        ddev exec "cd plugins/report-manager && php -r 'fwrite(STDOUT, \"Report Manager pre-commit using DDEV PHP \" . PHP_VERSION . PHP_EOL);' && composer ci"
    )
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "Report Manager pre-commit checks failed in DDEV (exit $status)." >&2
        exit "$status"
    fi
    echo "Report Manager pre-commit checks passed."
    exit 0
fi

if ! command -v php >/dev/null 2>&1 || ! command -v composer >/dev/null 2>&1; then
    echo "Standalone Report Manager checks require PHP and Composer." >&2
    exit 127
fi

composer check-platform-reqs --no-interaction
status=$?
if [ "$status" -ne 0 ]; then
    echo "Standalone Composer platform validation failed (exit $status)." >&2
    exit "$status"
fi

php scripts/check-quality-platform.php
status=$?
if [ "$status" -ne 0 ]; then
    php_version="$(php -r 'echo PHP_VERSION;' 2>/dev/null)"
    echo "Standalone quality tools are incompatible with active PHP ${php_version:-unknown} (exit $status)." >&2
    exit "$status"
fi

composer ci
status=$?
if [ "$status" -ne 0 ]; then
    echo "Report Manager pre-commit checks failed (exit $status)." >&2
    exit "$status"
fi

echo "Report Manager pre-commit checks passed."
exit 0
